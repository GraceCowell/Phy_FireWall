import random

#genrates random ip adress
def generate_random_ip():
    return f"192.168.1.{random.randint(0,20)}"

#takes ip adress and dictornty of rules, if mathces rules retunes action
def check_firewall_rules(ip,rules):
    for rule_ip, action in rules.items():
        if ip == rule_ip:
            return action
    return "allow"


def main():
    firewall_rules={
    "192.168.1.1" :"block",
    "192.168.1.4" :"block" ,
